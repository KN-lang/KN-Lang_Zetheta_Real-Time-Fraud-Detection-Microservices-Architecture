{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RuleHitEvent",
  "type": "object",
  "required": ["transaction_id", "rule_id", "score"],
  "properties": {
    "transaction_id": { "type": "string" },
    "rule_id": { "type": "string" },
    "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "reason": { "type": "string" },
    "score": { "type": "number" },
    "triggered_at": { "type": "string", "format": "date-time" }
  }
}
